# Mail settings for Netlify Functions (Serverless)
# Fill these in and copy to your Netlify environment variables as well.

# SMTP server configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender and recipient
# MAIL_FROM can be a name and email like: "AIMANIA Hub <aimania.hub@gmail.com>"
MAIL_FROM=
# Primary recipient for all form submissions
MAIL_TO=aimania.hub@gmail.com
# Optional fallback key used by code if MAIL_TO isn't set
CONTACT_EMAIL=
