# Mail settings for Netlify Functions (Serverless)
# Fill these in and copy to your Netlify environment variables as well.

# SMTP server configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender and recipient
# MAIL_FROM can be a name and email like: "AIMANIA Hub <aimania.hub@gmail.com>"
MAIL_FROM=bharatvan
# Primary recipient for all form submissions
MAIL_TO=aimania.hub@gmail.com
# Optional fallback key used by code if MAIL_TO isn't set
CONTACT_EMAIL=
# Optional: comma-separated CC recipients (e.g. a@x.com,b@y.com)
MAIL_CC=

# Resend API (simple alternative to SMTP)
RESEND_API_KEY=re_F4synQPT_ATMLB4NUrvwH7oao7rDAk7qJ

# Apps Script Web App (for payment + certificate backend)
APPSCRIPT_URL=https://script.google.com/macros/s/AKfycbzSXlDJ3Mk6IDW42lXUVj3W4uJ0J-306NqAtwwoR544IvEWlzxWotVSOFvlbmW4lqm3/exec
APPSCRIPT_SECRET=93537899

# Pricing (server and client). If zero/empty, amount validation is skipped on server.
PRICE_PER_PLANT=20000
VITE_PRICE_PER_PLANT=20000
